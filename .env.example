# Set these as environment variables in the shell that starts Uvicorn.
# This file is a reference; the application does not load .env files automatically.
DOCSCAN_DATA_DIR=data
DOCSCAN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DOCSCAN_SECURE_COOKIE=false

# Cloud: set DOCSCAN_ENV=production and DOCSCAN_SECURE_COOKIE=true.
# Supabase Connect > Direct > Session pooler (IPv4), port 5432.
# Supply the database password separately without URL encoding.
DATABASE_URL=
DATABASE_PASSWORD=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=docscan-private
# Optional: serve a built frontend at the same origin.
DOCSCAN_FRONTEND_DIR=
